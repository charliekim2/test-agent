# Working defaults for the no-Docker fallback. No secrets — this is a scaffold.
# These values are injected into the app by the Makefile (fallback) and by
# docker-compose.yml (Docker); the app does not auto-load this file. It documents
# the contract and is handy if you add your own dotenv loader.

# ---- Storage (single switch) ----
# Fallback default: file-backed SQLite. Docker overrides to the postgres URL.
DATABASE_URL=sqlite:///./app.sqlite

# Postgres creds (used by docker compose, and if you point DATABASE_URL at it).
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
POSTGRES_DB=interview

# ---- Fake ERP API ----
ERP_BASE_URL=http://localhost:9000
ERP_PORT=9000

# ---- Seed data ----
DATA_DIR=./data
