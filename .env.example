# Template of every environment variable the app understands. The committed
# .env already contains working fallback defaults; copy/edit this if you want to
# customize (e.g. point DATABASE_URL at your own Postgres).

# Storage. Schemes: sqlite:///<path>  or  postgresql://user:pw@host:port/db
DATABASE_URL=sqlite:///./app.sqlite

# Postgres connection (docker compose uses these for the postgres service).
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
POSTGRES_DB=interview

# Base URL of the fake ERP API.
ERP_BASE_URL=http://localhost:9000
ERP_PORT=9000

# Directory containing the seed documents (purchase_orders/ and invoices/).
DATA_DIR=./data
